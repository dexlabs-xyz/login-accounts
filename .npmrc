# npm 10 crashes ("Cannot read properties of null (reading 'edgesOut')") on
# Vite 8's optional devtools peer dependencies. Remove once npm fixes it.
legacy-peer-deps=true

# Don't run packages' install scripts. They're a common supply-chain attack
# path, and none of our dependencies need one (Railgun's only acts in React
# Native projects; websocket's native add-ons fall back to plain JavaScript).
# If a future package truly needs its script, run it deliberately and say why.
ignore-scripts=true
