{
  "name": "login-accounts",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm -w @login/server run dev\" \"npm -w @login/web run dev\"",
