{
  "name": "login-accounts",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm -w @login/server run dev\" \"npm -w @login/web run dev\"",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p .",
    "dev:oidc": "concurrently -n server,web,demo \"OIDC_ENABLED=1 npm -w @login/server run dev\" \"npm -w @login/web run dev\" \"npm -w @login/server run dev:oidc-client\"",
    "test:oidc:browser": "playwright test e2e/oidc.spec.ts",
    "oidc:generate-keys": "npm -w @login/server run oidc:generate-keys --"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "concurrently": "10.0.6",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@railgun-community/engine": "9.9.1",
    "@railgun-community/shared-models": "8.2.1"
  }
}
