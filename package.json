    "test:e2e": "playwright test",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "concurrently": "10.0.6",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  }
}
