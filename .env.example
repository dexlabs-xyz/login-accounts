
# KYC (Sumsub SANDBOX only; sandbox app tokens start with "sbx:")
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
# Optional on localhost (the server checks Sumsub's status API instead); required elsewhere
SUMSUB_WEBHOOK_SECRET=
# Levels set up in the Sumsub dashboard, in order from L1
SUMSUB_LEVELS=L1,L2

# TESTNET-ONLY gas faucet (testnet-gas/). Off when the key is empty.
# Sepolia only, never mainnet. Use a throwaway testnet wallet.
TESTNET_GAS_FAUCET_KEY=
# Optional. Defaults to a public Sepolia RPC.
SEPOLIA_RPC_URL=

# OIDC hosted demo: see docs/oidc-public-demo.md; generate secrets locally.
OIDC_JWKS=
OIDC_COOKIE_KEYS=
OIDC_CLIENTS=
OIDC_DEMO_ENABLED=
OIDC_DEMO_ORIGIN=
OIDC_DEMO_CLIENT_ID=
TESTNET_POOL_MNEMONIC=
